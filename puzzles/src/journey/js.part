<script>
(function(){
"use strict";
var J = JourneyEngine;
function $(id){ return document.getElementById(id); }
function load(k, fb){ try{ var v = localStorage.getItem(k); return v ? JSON.parse(v) : fb; }catch(e){ return fb; } }
function store(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
var KEY_SAVE = "quinndom.journey.v1", KEY_SET = "quinndom.journey.settings";
var S = J.normaliseState(load(KEY_SAVE, null));
var settings = Object.assign({ sfx: true, volume: 0.7, tab: "city" }, load(KEY_SET, {}));
function persist(){ store(KEY_SAVE, S); }
window.Journey = { getSave: function(){ return JSON.parse(JSON.stringify(S)); }, loadSave: function(s){ S = J.normaliseState(s); persist(); renderAll(); } };
function applySound(){ Sound.setConfig({ sfx: settings.sfx, volume: settings.volume }); $("btn-sound").setAttribute("aria-pressed", String(settings.sfx)); }
function sfx(n){ try{ if(settings.sfx) Sound.play(n); }catch(e){} }
function toast(msg){ var t = document.createElement("div"); t.className = "toast"; t.textContent = msg; $("toasts").appendChild(t); setTimeout(function(){ t.remove(); }, 2600); }
function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;" }[c]; }); }
var RESN = { wood: "Wood", stone: "Stone", metal: "Metal", food: "Food", mimosa: "Mimosa", psilocybe: "Psilocybe" };
var COUNTRY = { VN: "Vietnam", LA: "Laos", KH: "Cambodia", TH: "Thailand", MY: "Malaysia", ID: "Indonesia" };
var GAME = { elmundo: "ElMundo", wxrdie: "Wxrdie", mapnitude: "Mapnitude", kuduso: "Kuduso", zame: "Zame" };
function lootText(o){ return Object.keys(o).filter(function(r){ return o[r]; }).map(function(r){ return "+" + o[r] + " " + RESN[r]; }).join(", "); }
function sum(o){ return Object.keys(o).reduce(function(a, r){ return a + o[r]; }, 0); }
function fmtTime(sec){ sec = Math.max(0, Math.round(sec)); return Math.floor(sec / 60) + ":" + (sec % 60 < 10 ? "0" : "") + (sec % 60); }

/* ================= pixel art helpers ================= */
var g = null;                                   // current 2d context (logical pixel units)
function R(c, x, y, w, h){ g.fillStyle = c; g.fillRect(Math.round(x), Math.round(y), w, h); }
function prep(cv, lw, lh, cssH){
  var dpr = Math.min(3, window.devicePixelRatio || 1), cssW = cv.parentNode.clientWidth || 320, k = cssW / lw, h = cssH || Math.round(lh * k);
  cv.style.height = h + "px"; cv.width = Math.round(cssW * dpr); cv.height = Math.round(h * dpr);
  var c = cv.getContext("2d"); c.setTransform(dpr * k, 0, 0, dpr * k, 0, 0); c.imageSmoothingEnabled = false; return { c: c, k: k, w: cssW, h: h };
}
function hero(x, y, hat, body, bob){
  y -= bob || 0;
  R("#14261B", x - 4, y - 9, 8, 1); R(hat, x - 3, y - 11, 6, 3); R(hat, x - 4, y - 9, 8, 1);
  R("#F2C9A0", x - 3, y - 8, 6, 4); R("#14261B", x - 2, y - 7, 1, 1); R("#14261B", x + 1, y - 7, 1, 1);
  R(body, x - 4, y - 4, 8, 4); R("#14261B", x - 3, y, 2, 1); R("#14261B", x + 1, y, 2, 1);
}
var HEROC = { navigator: ["#3A7BD5", "#1D3557"], scholar: ["#8E7DBE", "#5B3F7A"], engineer: ["#E67E22", "#8D4A13"] };
function party(x, y, t){ var i = 0; Object.keys(HEROC).forEach(function(h){ hero(x - 8 + i * 8, y, HEROC[h][0], HEROC[h][1], Math.round(Math.sin(t / 180 + i * 1.3) * 0.8 + 0.8)); i++; }); }
function critter(kind, x, y, t){                // x, y = bottom centre
  var w = Math.sin(t / 150) > 0 ? 1 : 0;
  switch(kind){
    case "rat": R("#8D6E63", x - 7, y - 6, 12, 5); R("#8D6E63", x + 3, y - 8, 5, 5); R("#5A3A22", x + 4, y - 10, 2, 2); R("#C0392B", x + 6, y - 7, 1, 1); R("#E7A9A0", x - 12, y - 4, 5, 1); R("#14261B", x - 5, y - 1, 2, 1 + w); R("#14261B", x + 2, y - 1, 2, 2 - w); break;
    case "leech": for(var i = 0; i < 5; i++){ R(i % 2 ? "#3F7A32" : "#5BAA46", x - 9 + i * 4, y - 4 - Math.round(Math.sin(t / 120 + i)) , 4, 3); } R("#14261B", x + 9, y - 5, 1, 1); break;
    case "bat": R("#5B3F7A", x - 10, y - 11 - w, 6, 3); R("#5B3F7A", x + 4, y - 11 - w, 6, 3); R("#3C2A52", x - 3, y - 10, 6, 6); R("#3C2A52", x - 3, y - 12, 2, 2); R("#3C2A52", x + 1, y - 12, 2, 2); R("#F7C948", x - 2, y - 8, 1, 1); R("#F7C948", x + 1, y - 8, 1, 1); break;
    case "cobra": R("#2E8B57", x - 6, y - 4, 12, 4); R("#2E8B57", x - 1, y - 12, 3, 9); R("#3FB57A", x - 4, y - 14, 9, 4); R("#14261B", x - 2, y - 13, 1, 1); R("#14261B", x + 1, y - 13, 1, 1); if(w) R("#C0392B", x + 2, y - 10, 3, 1); break;
    case "monitor": R("#7A8450", x - 10, y - 5, 18, 4); R("#7A8450", x + 8, y - 6, 5, 3); R("#7A8450", x - 16, y - 3, 6, 2); R("#14261B", x - 8, y - 1, 2, 1 + w); R("#14261B", x + 4, y - 1, 2, 2 - w); R("#F7C948", x + 11, y - 6, 1, 1); break;
    case "crab": R("#E0533D", x - 6, y - 6, 12, 5); R("#E0533D", x - 11, y - 10 - w, 4, 4); R("#E0533D", x + 7, y - 10 - w, 4, 4); R("#14261B", x - 3, y - 8, 1, 2); R("#14261B", x + 2, y - 8, 1, 2); R("#14261B", x - 7, y - 1, 2, 1); R("#14261B", x + 5, y - 1, 2, 1); break;
    case "octo": R("#3A7BD5", x - 6, y - 13, 12, 8); R("#F7C948", x - 4, y - 11, 2, 2); R("#F7C948", x + 1, y - 10, 2, 2); R("#14261B", x - 3, y - 9, 1, 1); R("#14261B", x + 2, y - 8, 1, 1); for(var j = 0; j < 4; j++) R("#2B5FA8", x - 7 + j * 4, y - 5, 2, 5 - (w && j % 2 ? 1 : 0)); break;
    case "poacher": for(var p = 0; p < 3; p++){ var px = x - 9 + p * 8; R("#5A3A22", px, y - 9, 1, 9 + (p % 2)); R("#C8693D", px - 2, y - 6, 5, 4); R("#F2C9A0", px - 1, y - 9, 3, 3); R("#14261B", px - 1, y - 2, 1, 2); R("#14261B", px + 1, y - 2, 1, 2); } break;
    case "convoy": R("#8D6E63", x - 11, y - 10, 14, 8); R("#C8693D", x + 3, y - 8, 8, 6); R("#9ED0F0", x + 8, y - 7, 2, 2); R("#14261B", x - 8, y - 3, 4, 3); R("#14261B", x + 4, y - 3, 4, 3); break;
    case "skiff": R("#8D6E63", x - 11, y - 4, 22, 4); R("#F3F7EA", x - 1, y - 14, 9, 10); R("#C0392B", x - 1, y - 17, 5, 3); R("#5A3A22", x - 2, y - 15, 1, 11); R("#3A7BD5", x - 12, y - 1, 24, 1); break;
    case "tiger": R("#E8862E", x - 14, y - 12, 26, 9); R("#E8862E", x + 8, y - 17, 11, 9); R("#F3F7EA", x + 12, y - 11, 6, 3); R("#E8862E", x + 9, y - 19, 3, 3); R("#E8862E", x + 16, y - 19, 3, 3); R("#14261B", x + 11, y - 14, 2, 2); R("#14261B", x + 16, y - 14, 2, 2); R("#E8862E", x - 20, y - 11, 7, 2); R("#14261B", x - 10, y - 12, 2, 6); R("#14261B", x - 4, y - 12, 2, 7); R("#14261B", x + 2, y - 12, 2, 6); R("#E8862E", x - 12, y - 3, 4, 3 + w); R("#E8862E", x + 6, y - 3, 4, 4 - w); break;
    case "komodo": R("#6B6A3E", x - 18, y - 9, 30, 7); R("#6B6A3E", x + 11, y - 11, 9, 5); R("#6B6A3E", x - 28, y - 6, 11, 3); R("#8C8A52", x - 12, y - 9, 3, 2); R("#8C8A52", x - 2, y - 9, 3, 2); R("#14261B", x + 17, y - 10, 1, 1); if(w) { R("#C0392B", x + 20, y - 8, 4, 1); R("#C0392B", x + 23, y - 9, 1, 1); R("#C0392B", x + 23, y - 7, 1, 1); } R("#4E4D2C", x - 14, y - 3, 4, 3 + w); R("#4E4D2C", x + 6, y - 3, 4, 4 - w); break;
  }
}
var ART = { 1: "rat", 3: "leech", 4: "poacher", 7: "bat", 8: "cobra", 9: "tiger", 11: "monitor", 13: "convoy", 15: "crab", 16: "skiff", 18: "octo", 19: "komodo" };
function pickup(kind, x, y, t){
  var bob = Math.round(Math.sin(t / 220) * 1);
  if(kind === "flower"){ R("#2E9B57", x, y - 6, 1, 6); R("#FF3EA5", x - 3, y - 11 + bob, 7, 5); R("#FF8CC8", x - 1, y - 13 + bob, 3, 3); R("#F7C948", x, y - 9 + bob, 1, 1); }
  else if(kind === "shroom"){ R("#F3F7EA", x - 1, y - 6, 3, 6); R("#C0392B", x - 5, y - 11 + bob, 11, 5); R("#F3F7EA", x - 3, y - 10 + bob, 2, 2); R("#F3F7EA", x + 2, y - 9 + bob, 2, 2); }
  else if(kind === "metal"){ R("#5C7080", x - 6, y - 12 + bob, 12, 11); R("#9AA5A0", x - 6, y - 12 + bob, 12, 2); R("#14261B", x - 6, y - 7 + bob, 12, 1); }
  else { R("#14261B", x - 7, y - 13 + bob, 14, 13); R("#F7C948", x - 6, y - 12 + bob, 12, 11); R("#E9B93A", x - 6, y - 4 + bob, 12, 3); R("#14261B", x - 2, y - 10 + bob, 4, 1); R("#14261B", x + 1, y - 9 + bob, 1, 2); R("#14261B", x - 1, y - 7 + bob, 2, 1); R("#14261B", x - 1, y - 5 + bob, 1, 1); }
}
function pickupKind(n){ return n.give.mimosa ? "flower" : n.give.psilocybe ? "shroom" : n.give.metal ? "metal" : "crate"; }
function townSprite(x, y){ R("#14261B", x - 8, y - 12, 16, 12); R("#F3E6C4", x - 7, y - 8, 14, 7); R("#C0392B", x - 9, y - 13, 18, 4); R("#8D6E63", x - 2, y - 5, 4, 5); R("#9ED0F0", x + 3, y - 6, 3, 3); R("#2E9B57", x + 7, y - 17, 1, 5); R("#F7C948", x + 8, y - 17, 3, 2); }
function gateSprite(x, y){ R("#8D6E63", x - 9, y - 14, 4, 14); R("#8D6E63", x + 5, y - 14, 4, 14); R("#C0392B", x - 10, y - 17, 20, 4); R("#F7C948", x - 5, y - 19, 10, 2); }
function flagSprite(x, y){ R("#F3F7EA", x - 1, y - 20, 2, 20); R("#2E9B57", x + 1, y - 20, 9, 6); R("#F7C948", x - 3, y, 6, 2); }

/* ================= HUD ================= */
var prevRes = null;
function renderHud(){
  var max = J.maxHp(S), pct = Math.max(0, Math.min(1, S.hp / max));
  $("res").innerHTML = J.RES.map(function(r){ return '<div class="rc ' + r + '" id="rc-' + r + '"><i>' + RESN[r] + '</i><b>' + S.res[r] + '</b></div>'; }).join("");
  if(prevRes) J.RES.forEach(function(r){ if(prevRes[r] !== S.res[r]){ var e = $("rc-" + r); e.classList.add("flash"); } });
  prevRes = Object.assign({}, S.res);
  $("hp-i").style.width = (pct * 100) + "%"; $("hp").className = "hp" + (pct < 0.3 ? " low" : pct < 0.6 ? " mid" : "");
  $("hp-t").textContent = "Army " + S.hp + " / " + max + (S.rest ? " · resting " + fmtTime(J.restLeft(S, Date.now())) : "");
  $("march").textContent = S.march; $("credit").textContent = J.credit(S); $("day").textContent = S.day;
}
function hurt(){ var h = $("hp"); h.classList.remove("hurt"); void h.offsetWidth; h.classList.add("hurt"); }

/* ================= CITY ================= */
var COL = { Housing: "#E9D8A6", Production: "#7BC67A", Infrastructure: "#9ED0F0", Military: "#C8693D", Care: "#F3F7EA" };
var PLOTS = ["bamboo", "timber", "quarry", "mycelium", "solar", "herohall", "barracks", "armory", "hospital"];
var PLOT_XY = [[46, 38], [80, 36], [114, 38], [40, 50], [80, 49], [120, 50], [52, 62], [80, 62], [108, 62]];
function drawBuilding(id, lv, x, y, t){
  if(!lv){ g.fillStyle = "rgba(255,255,255,.55)"; [[-6, -6], [4, -6], [-6, 0], [4, 0]].forEach(function(o){ g.fillRect(x + o[0], y + o[1], 3, 1); g.fillRect(x + o[0] + (o[0] > 0 ? 2 : 0), y + o[1], 1, 3); }); return; }
  var up = lv * 2;
  switch(id){
    case "bamboo": R("#14261B", x - 7, y - 9 - up, 14, 9 + up); R("#E9D8A6", x - 6, y - 8 - up, 12, 8 + up); R("#2E9B57", x - 8, y - 12 - up, 16, 4); R("#8D6E63", x - 1, y - 4, 3, 4); break;
    case "timber": R("#5A3A22", x - 5, y - 4, 2, 4); R("#2E9B57", x - 8, y - 12 - up, 8, 9 + up); R("#5A3A22", x + 3, y - 4, 2, 4); R("#237A43", x - 1, y - 14 - up, 9, 11 + up); break;
    case "quarry": R("#6F7C76", x - 8, y - 6 - up, 10, 6 + up); R("#9AA5A0", x - 2, y - 9 - up, 10, 9 + up); R("#C9D0CC", x - 2, y - 9 - up, 10, 2); break;
    case "mycelium": R("#F3F7EA", x - 2, y - 6, 4, 6); R("#8E7DBE", x - 8, y - 12 - up, 16, 7); R("#F3F7EA", x - 5, y - 10 - up, 2, 2); R("#F3F7EA", x + 2, y - 9 - up, 2, 2); break;
    case "solar": R("#14261B", x - 9, y - 8 - up, 18, 6); R("#3A7BD5", x - 8, y - 7 - up, 16, 4); R("#9ED0F0", x - 8, y - 7 - up, 16, 1); R("#5C7080", x - 1, y - 3, 2, 3); break;
    case "herohall": R("#14261B", x - 8, y - 11 - up, 16, 11 + up); R("#9AA5A0", x - 7, y - 10 - up, 14, 10 + up); R("#C0392B", x - 2, y - 15 - up, 5, 4); R("#14261B", x - 2, y - 5, 4, 5); break;
    case "barracks": R("#14261B", x - 9, y - 8 - up, 18, 8 + up); R("#C8693D", x - 8, y - 7 - up, 16, 7 + up); R("#8D4A13", x - 9, y - 11 - up, 18, 3); break;
    case "armory": R("#14261B", x - 8, y - 8 - up, 16, 8 + up); R("#5C7080", x - 7, y - 7 - up, 14, 7 + up); R("#9AA5A0", x - 3, y - 5, 6, 2); break;
    case "hospital": R("#14261B", x - 8, y - 9 - up, 16, 9 + up); R("#F3F7EA", x - 7, y - 8 - up, 14, 8 + up); R("#C0392B", x - 1, y - 7 - up, 3, 7); R("#C0392B", x - 3, y - 5 - up, 7, 3); break;
  }
  for(var i = 0; i < lv; i++) R("#F7C948", x - 8 + i * 4, y + 2, 3, 2);
}
var cityMeta = null;
function drawCity(t){
  var cv = $("cityCv"); if(!cv.offsetParent) return; var P = prep(cv, 160, 90); g = P.c; cityMeta = P;
  for(var y = 0; y < 90; y += 6) R(y < 24 ? "#5BA8F5" : y < 48 ? "#8EC5FC" : y < 72 ? "#B5DAFF" : "#CFE9FF", 0, y, 160, 6);
  R("#FFF3C4", 128, 10, 10, 10); R("#FFE08A", 130, 12, 6, 6);
  for(var c = 0; c < 4; c++){ var cx = ((c * 53 + t / 90) % 200) - 20; R("#fff", cx, 14 + (c % 2) * 18, 16, 4); R("#fff", cx + 3, 11 + (c % 2) * 18, 9, 4); }
  var bob = Math.round(Math.sin(t / 700) * 1.2);
  for(var r = 0; r < 14; r++){ var w = 118 - r * 4; R(r % 4 === 0 ? "#8FD694" : "#6CC36C", 80 - w / 2, 28 + r + bob, w, 1); }
  for(var u = 0; u < 22; u++){ var wu = 60 - u * 2.6; R(u % 5 === 0 ? "#8D6E63" : "#6E5040", 80 - wu / 2, 42 + u + bob, Math.max(2, wu), 1); }
  for(var tf = 0; tf < 5; tf++) R("#5A3A22", 70 + tf * 5, 64 + tf * 4 + bob, 2, 4);
  PLOTS.forEach(function(id, i){ drawBuilding(id, S.buildings[id], PLOT_XY[i][0], PLOT_XY[i][1] + 8 + bob, t); });
}
$("cityCv").addEventListener("click", function(e){
  if(!cityMeta) return; var r = this.getBoundingClientRect(), lx = (e.clientX - r.left) / cityMeta.k, ly = (e.clientY - r.top) / cityMeta.k, best = -1, bd = 1e9;
  PLOT_XY.forEach(function(p, i){ var d = Math.abs(lx - p[0]) + Math.abs(ly - p[1] - 2) * 1.5; if(d < bd){ bd = d; best = i; } });
  if(best >= 0 && bd < 22){ var el = $("card-" + PLOTS[best]); if(el){ el.scrollIntoView({ behavior: "smooth", block: "center" }); el.classList.remove("hi"); void el.offsetWidth; el.classList.add("hi"); sfx("tap"); } }
});
function costHtml(cost){ return '<div class="cost">' + Object.keys(cost).filter(function(r){ return cost[r]; }).map(function(r){ return '<span class="' + (S.res[r] < cost[r] ? "short" : "") + '">' + cost[r] + " " + RESN[r] + "</span>"; }).join("") + "</div>"; }
function renderCards(){
  $("cards").innerHTML = J.BUILDING_ORDER.map(function(id){
    var b = J.BUILDINGS[id], lv = S.buildings[id], max = lv >= J.MAX_LEVEL, cost = max ? null : J.upgradeCost(id, lv), ok = !max && J.canAfford(S, cost), pips = "";
    for(var i = 1; i <= J.MAX_LEVEL; i++) pips += '<i class="' + (i <= lv ? "on" : "") + '"></i>';
    var puz = "";
    if(b.puzzle){
      var P = J.PUZZLES[b.puzzle], open = lv >= J.PUZZLE_UNLOCK_LEVEL;
      puz = open ? '<div class="puz open"><span><b>' + P.name + '</b> unlocked' + (S.playedToday[b.puzzle] ? " · paid today" : " · pays today") + '</span><button class="btn small primary" data-act="play" data-p="' + b.puzzle + '">Play</button></div>'
                 : '<div class="puz locked"><span>Level ' + J.PUZZLE_UNLOCK_LEVEL + ' unlocks <b>' + P.name + '</b></span></div>';
    }
    return '<div class="card bcard" id="card-' + id + '"><div class="top"><div><div class="grp">' + b.group + '</div><h3>' + b.name + '</h3></div><div class="pips" title="Level ' + lv + '">' + pips + '</div></div>' +
      '<div class="note">' + b.note + '</div>' + puz +
      (max ? '<div class="note"><b>Max level.</b></div>' : costHtml(cost) + '<button class="btn ' + (ok ? "primary" : "") + '" data-act="up" data-id="' + id + '"' + (ok ? "" : " disabled") + '>' + (lv ? "Upgrade to level " + (lv + 1) : "Build") + '</button>') + '</div>';
  }).join("");
}
$("cards").addEventListener("click", function(e){
  var b = e.target.closest("button"); if(!b) return; var act = b.getAttribute("data-act");
  if(act === "up") doUpgrade(b.getAttribute("data-id")); else if(act === "play") invitePlay(b.getAttribute("data-p"));
});
function doUpgrade(id){
  var r = J.upgrade(S, id); if(!r.ok){ toast(r.error); sfx("notquite"); return; }
  persist(); sfx("stamp"); renderAll();
  r.events.forEach(function(ev){ if(ev.type === "unlock"){ setTimeout(function(){ sfx("milestone"); invitePlay(ev.puzzle, true); }, 350); } });
}

/* ================= popups ================= */
var popCb = null;
function popup(o){
  $("pop-title").textContent = o.title; $("pop-body").innerHTML = o.html || ""; var f = $("pop-actions"); f.innerHTML = "";
  (o.buttons || [{ label: "OK", primary: true }]).forEach(function(b){ var x = document.createElement("button"); x.className = "btn" + (b.primary ? " primary" : "") + (b.danger ? " danger" : ""); x.textContent = b.label; x.onclick = function(){ $("dlg").close(); if(b.fn) b.fn(); }; f.appendChild(x); });
  popCb = o.onPick || null; $("dlg").showModal();
}
$("pop-body").addEventListener("click", function(e){ var b = e.target.closest("[data-d]"); if(b && popCb){ var d = b.getAttribute("data-d"); $("dlg").close(); popCb(d); } });
function invitePlay(puzzle, fresh){
  var P = J.PUZZLES[puzzle], sug = J.suggestedDifficulty(S), paid = S.playedToday[puzzle], hb = J.heroBonus(S, puzzle);
  var btns = ["easy", "normal", "hard"].map(function(d){ var rw = J.puzzleReward(S, puzzle, d); return '<button class="btn' + (d === sug ? " sug" : "") + '" data-d="' + d + '">' + d[0].toUpperCase() + d.slice(1) + '<small>' + (paid ? "practice" : sum(rw) + " resources") + '</small></button>'; }).join("");
  popup({ title: fresh ? "New puzzle: " + P.name + "!" : "Play " + P.name,
    html: '<p>' + (fresh ? "Your upgrade opened a new puzzle. " : "") + P.blurb + ' Solving it pays the city' + (paid ? " (today's reward is already earned, so this one is practice)" : "") + ' and gives <b>1 march point</b>.</p><p>Your heroes add <b>+' + hb.hints + ' hint' + (hb.hints === 1 ? "" : "s") + '</b>' + (hb.seconds ? ' and <b>+' + hb.seconds + ' seconds</b>' : "") + '.</p><div class="diffs">' + btns + '</div>',
    buttons: [{ label: "Later" }], onPick: function(d){ openPuzzle({ puzzle: puzzle, difficulty: d }); } });
}

/* ================= ARMY ================= */
function renderArmy(){
  var max = J.maxHp(S), troops = S.troops, credit = Math.floor(J.credit(S) / 10), wb = Math.round(30 * J.wellbeing(S)), tr = 5 * S.trophies.length, rest = S.rest ? J.restLeft(S, Date.now()) : 0, rs = J.restSeconds(S);
  var heroes = Object.keys(J.HEROES).map(function(h){
    var H = J.HEROES[h], lv = S.heroes[h], c = J.heroCost(S, h), capped = lv >= J.heroMaxLevel(S), gate = lv + 1 === J.GATE_LEVEL;
    var btn = lv >= J.HERO_MAX ? '<b>Max level</b>' : '<button class="btn small" data-act="hero" data-h="' + h + '"' + (S.buildings.herohall && !capped ? "" : " disabled") + '>Level up · ' + c + ' Food' + (gate ? " + 1 Psilocybe" : "") + '</button>';
    return '<div class="card hero"><div class="grp">' + H.puzzles.map(function(p){ return J.PUZZLES[p].name; }).join(" · ") + '</div><h3>' + H.name + '</h3><div class="lv">Level ' + lv + '</div><div class="note">' + (lv >= 1 ? "+1 hint in its puzzles" : "") + (lv >= 3 ? ", +30 seconds" : ", level 3 adds +30 seconds") + '</div><div style="margin-top:8px">' + (S.buildings.herohall ? btn : '<span class="note">Build the Hero hall to level up.</span>') + (S.buildings.herohall && capped && lv < J.HERO_MAX ? '<div class="note">Upgrade the Hero hall for more levels.</div>' : "") + '</div></div>';
  }).join("");
  $("v-army").innerHTML =
    '<div class="card"><h2>Army health</h2><div class="note">The army is your heroes\' health. Fights drain it; the Hospital heals it.</div>' +
    '<div class="statgrid"><div class="stat"><i>Health</i><b>' + S.hp + ' / ' + max + '</b></div><div class="stat"><i>Attack power</i><b>' + J.attackPower(S) + '</b></div><div class="stat"><i>Armor</i><b>-' + Math.round(J.armorReduction(S) * 100) + '% damage</b></div><div class="stat"><i>Citizens housed</i><b>' + Math.round(J.wellbeing(S) * 100) + '%</b></div></div>' +
    '<p class="note" style="margin:8px 0 0">Max health = 40 base + ' + 2 * troops + ' troops + ' + credit + ' Credit + ' + wb + ' citizens + ' + tr + ' trophies = <b>' + max + '</b>. Citizen wellbeing is a placeholder until real citizens arrive (it follows Bamboo homes).</p></div>' +
    '<div class="sect card"><h3>Hospital</h3>' + (S.buildings.hospital ? (S.rest ? '<div class="restbar"><i style="width:' + Math.round(100 * (1 - rest / rs)) + '%"></i></div><p class="note">Resting… ' + fmtTime(rest) + ' left. Marching is paused.</p>' : '<p class="note">One short rest (' + fmtTime(rs) + ') heals the whole army.</p><button class="btn primary" data-act="rest"' + (S.hp >= max ? " disabled" : "") + '>' + (S.hp >= max ? "Army is healthy" : "Rest the army") + '</button>') : '<p class="note">Build the Hospital in the City to heal the army.</p>') + '</div>' +
    '<div class="sect card"><h3>Barracks and Armory</h3><div class="statgrid"><div class="stat"><i>Troops</i><b>' + S.troops + ' / ' + J.troopCap(S) + '</b></div><div class="stat"><i>Armor pieces</i><b>' + S.armor + ' / ' + J.armorCap(S) + '</b></div></div><div class="marchbar" style="margin-top:10px"><button class="btn" data-act="train">Train ' + J.TROOPS_PER_TRAIN + ' troops · ' + J.TRAIN_FOOD + ' Food</button><button class="btn" data-act="forge">Forge armor · ' + J.ARMOR_METAL + ' Metal</button></div></div>' +
    '<div class="sect"><h3>Heroes</h3><div class="herocards">' + heroes + '</div></div>' +
    '<div class="sect card"><h3>Mimosa and Psilocybe</h3><p class="note">Found on the road. <b>Mimosa</b> gives +1 hint in every puzzle for the rest of the day (you have ' + S.res.mimosa + '). <b>Psilocybe</b> is spent automatically when a hero reaches level ' + J.GATE_LEVEL + ' (you have ' + S.res.psilocybe + ').</p><button class="btn" data-act="mimosa"' + (S.mimosaDay === S.day ? " disabled" : "") + '>' + (S.mimosaDay === S.day ? "Mimosa active today" : "Use 1 Mimosa") + '</button></div>' +
    '<div class="sect card"><h3>Trophies</h3>' + (S.trophies.length ? '<div class="trophies">' + S.trophies.map(function(t){ return "<span>" + esc(t) + " · +5 max health</span>"; }).join("") + "</div>" : '<p class="note">Beat a big boss to earn one.</p>') + '</div>';
}
$("v-army").addEventListener("click", function(e){
  var b = e.target.closest("button"); if(!b) return; var a = b.getAttribute("data-act"), r;
  if(a === "train") r = J.trainTroops(S); else if(a === "forge") r = J.forgeArmor(S); else if(a === "hero") r = J.levelHero(S, b.getAttribute("data-h"));
  else if(a === "mimosa") r = J.useMimosa(S); else if(a === "rest"){ r = J.startRest(S, Date.now()); if(r.ok) sfx("pageflip"); }
  else return;
  if(!r.ok){ toast(r.error); sfx("notquite"); return; } if(a !== "rest") sfx(a === "hero" ? "milestone" : "collect"); persist(); renderAll();
});

/* ================= ROAD: isometric free walk ================= */
var TW = 22, TH = 11, SPEED = 62, WALK = 2.9;
var REGION = { VN: { n: "Red River Delta", lv: "Easy", r: 1, b: "jungle" }, LA: { n: "Mekong Highlands", lv: "Easy", r: 2, b: "jungle" }, KH: { n: "Tonlé Sap Basin", lv: "Normal", r: 3, b: "jungle" },
  TH: { n: "Chao Phraya Marshes", lv: "Normal", r: 4, b: "swamp" }, MY: { n: "Strait Jungles", lv: "Hard", r: 5, b: "swamp" }, ID: { n: "Ring of Fire Isles", lv: "Hard", r: 6, b: "volcano" } };
var BIOME = { jungle: { a: "#6FBF6A", b: "#63B25F", rock: "#3F7A3F", bg: "#27422D" }, swamp: { a: "#6AA89A", b: "#5C9A8C", rock: "#33645B", bg: "#1D3735" }, volcano: { a: "#7C6757", b: "#6E5A4B", rock: "#3A2E28", bg: "#241716" } };
var NP = J.ROAD.map(function(n, k){ return { x: 7 + 6.6 * k, y: 16 + 7.5 * Math.sin(k * 0.72) }; });
var STAGE = (function(){ var cnt = {}, out = []; J.ROAD.forEach(function(n){ cnt[n.country] = (cnt[n.country] || 0) + 1; out.push(REGION[n.country].r + "-" + cnt[n.country]); }); return out; })();
function near(x, y){
  var best = 1e9, bp = 0;
  for(var k = 0; k < NP.length - 1; k++){ var a = NP[k], b = NP[k + 1], dx = b.x - a.x, dy = b.y - a.y, t = ((x - a.x) * dx + (y - a.y) * dy) / (dx * dx + dy * dy); t = t < 0 ? 0 : t > 1 ? 1 : t; var px = a.x + dx * t - x, py = a.y + dy * t - y, d = Math.sqrt(px * px + py * py); if(d < best){ best = d; bp = k + t; } }
  return { d: best, p: bp };
}
function along(p){ var k = Math.min(NP.length - 2, Math.max(0, Math.floor(p))), t = p - k, a = NP[k], b = NP[k + 1]; return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }; }
function hash(x, y){ var h = (Math.imul(x, 73856093) ^ Math.imul(y, 19349663)) >>> 0; return (h ^ (h >>> 13)) >>> 0; }
var tcache = {};
function tinfo(gx, gy){ var key = gx * 4096 + gy, c = tcache[key]; if(!c){ var n = near(gx, gy); c = tcache[key] = { d: n.d, p: n.p, h: hash(gx, gy) % 1000 }; } return c; }
var pos = { x: NP[S.node].x, y: NP[S.node].y }, cam = null, keys = {}, joy = null, lastBand = -1, banner = { t: -9, text: "" }, lastAct = "", walkT = 0, hintOnce = {};
function placeAt(k){ pos.x = NP[k].x; pos.y = NP[k].y; cam = null; lastBand = -1; }
function canAdvance(){ return !S.rest && S.hp > 0 && !J.pending(S) && J.nodeAt(S.node).type !== "end" && S.march >= 1; }
function limitP(){ return S.node + (canAdvance() ? 1 : 0); }
function curP(){ return near(pos.x, pos.y).p; }
function enemyPos(k){ return along(k + 0.16); }
function tree(x, y, kind, h){
  if(kind === "tree"){ R("#5A3A22", x - 1, y - 5, 2, 5); R("#237A43", x - 5, y - 9, 10, 4); R("#2E8B4E", x - 5, y - 14, 10, 6); R("#3FA55F", x - 3, y - 16, 6, 3); }
  else if(kind === "dead"){ R("#4A3A33", x - 1, y - 13, 2, 13); R("#4A3A33", x - 5, y - 10, 4, 1); R("#4A3A33", x + 1, y - 8, 5, 1); R("#4A3A33", x - 3, y - 13, 1, 3); }
  else if(kind === "spike"){ R("#2B2220", x - 3, y - 9, 6, 9); R("#443632", x - 2, y - 13, 4, 4); R("#E4572E", x - 5, y - 1, 10, 1); }
  else { R("#7B8780", x - 5, y - 5, 10, 5); R("#A0AAA4", x - 4, y - 7, 6, 2); }
}
function tileDiamond(sx, sy, col){ g.fillStyle = col; g.beginPath(); g.moveTo(sx, sy - TH / 2 - 0.5); g.lineTo(sx + TW / 2 + 0.5, sy); g.lineTo(sx, sy + TH / 2 + 0.5); g.lineTo(sx - TW / 2 - 0.5, sy); g.closePath(); g.fill(); }
function isoX(gx, gy){ return (gx - gy) * TW / 2; } function isoY(gx, gy){ return (gx + gy) * TH / 2; }
function roadFrame(t){
  var cv = $("roadCv"); if(!cv.offsetParent) return;
  var dpr = Math.min(3, window.devicePixelRatio || 1), cssW = cv.parentNode.clientWidth || 320, cssH = Math.round(Math.max(300, Math.min(440, window.innerHeight * 0.5)));
  var k = Math.max(2.6, Math.min(3.6, cssW / 150)), VW = cssW / k, VH = cssH / k;
  if(cv.width !== Math.round(cssW * dpr) || cv.height !== Math.round(cssH * dpr)){ cv.width = Math.round(cssW * dpr); cv.height = Math.round(cssH * dpr); cv.style.height = cssH + "px"; }
  var c = cv.getContext("2d"); c.imageSmoothingEnabled = false; g = c;
  var dt = Math.min(0.05, (t - (roadFrame.last || t)) / 1000); roadFrame.last = t; update(dt, t);
  var np = near(pos.x, pos.y), band = Math.min(J.ROAD.length - 1, Math.round(np.p)), reg = REGION[J.ROAD[band].country], bio = BIOME[reg.b];
  if(band !== lastBand){ var oc = lastBand < 0 ? null : J.ROAD[lastBand].country; lastBand = band; if(J.ROAD[band].country !== oc){ banner = { t: t, text: "Region " + reg.r + " · " + reg.n + " · " + reg.lv }; } }
  var px = isoX(pos.x, pos.y), py = isoY(pos.x, pos.y); if(!cam) cam = { x: px, y: py }; cam.x += (px - cam.x) * 0.12; cam.y += (py - cam.y) * 0.12;
  c.setTransform(dpr * k, 0, 0, dpr * k, 0, 0); g.fillStyle = bio.bg; g.fillRect(0, 0, VW, VH);
  var ox = Math.round(VW / 2 - cam.x), oy = Math.round(VH / 2 - cam.y + 6); c.translate(ox, oy);
  var objs = [], cx = Math.round(pos.x), cy = Math.round(pos.y), R0 = Math.ceil(Math.max(VW / TW, VH / TH)) + 4;
  for(var gx = cx - R0; gx <= cx + R0; gx++){ for(var gy = cy - R0; gy <= cy + R0; gy++){
    var sx = isoX(gx, gy), sy = isoY(gx, gy); if(sx + ox < -TW || sx + ox > VW + TW || sy + oy < -TH * 3 || sy + oy > VH + TH * 3) continue;
    var ti = tinfo(gx, gy); if(ti.d > 5.8) continue; var bb = BIOME[REGION[J.ROAD[Math.min(J.ROAD.length - 1, Math.round(ti.p))].country].b], chk = (gx + gy) & 1;
    if(ti.d < 1.3 + (ti.h % 3) * 0.2){ tileDiamond(sx, sy, ti.d > 1.0 ? "#CDAA6A" : chk ? "#E6C98E" : "#DDBD7F"); }
    else if(ti.d < 3.3){ tileDiamond(sx, sy, chk ? bb.a : bb.b); if(ti.h % 23 === 0) objs.push({ z: gx + gy + 0.3, f: (function(a, b){ return function(){ R("#F7C948", a, b - 2, 1, 1); R("#fff", a + 2, b - 1, 1, 1); }; })(sx, sy) }); }
    else { var lava = bb.rock === "#3A2E28" && ti.h % 5 === 0; tileDiamond(sx, sy, lava ? (Math.floor(t / 400 + ti.h) % 2 ? "#E4572E" : "#C8401F") : bb.rock);
      if(!lava && ti.h % 100 < 58){ var kind = bb.rock === "#3F7A3F" ? (ti.h % 7 === 0 ? "rock" : "tree") : bb.rock === "#33645B" ? (ti.h % 4 === 0 ? "rock" : "dead") : (ti.h % 3 === 0 ? "rock" : "spike"); objs.push({ z: gx + gy + 0.5, f: (function(a, b, kk){ return function(){ tree(Math.round(a), Math.round(b + 3), kk); }; })(sx, sy, kind) }); } }
  } }
  J.ROAD.forEach(function(n, idx){
    var p = NP[idx], sx = isoX(p.x, p.y), sy = isoY(p.x, p.y), done = S.cleared[n.id];
    if(sx + ox < -40 || sx + ox > VW + 40 || sy + oy < -50 || sy + oy > VH + 50) return;
    if(n.type === "start") objs.push({ z: p.x + p.y - 1, f: function(){ gateSprite(Math.round(sx), Math.round(sy + 4)); } });
    else if(n.type === "end") objs.push({ z: p.x + p.y, f: function(){ flagSprite(Math.round(sx), Math.round(sy + 4)); } });
    else if(n.type === "town") objs.push({ z: p.x + p.y - 1, f: function(){ townSprite(Math.round(sx), Math.round(sy - 2)); campfire(Math.round(sx + 14), Math.round(sy + 6), t); } });
    else if(n.give){ if(!done) objs.push({ z: p.x + p.y, f: function(){ pickup(pickupKind(n), Math.round(sx), Math.round(sy + 4), t); } }); }
    else if(n.enemy || n.boss){ var ep = enemyPos(idx), ex = Math.round(isoX(ep.x, ep.y)), ey = Math.round(isoY(ep.x, ep.y) + 4);
      if(!done) objs.push({ z: ep.x + ep.y, f: function(){ var isB = !!n.boss, sw = !isB && n.type !== "mini";
        if(sw){ [[-9, 2, 0.65], [8, 3, 0.65], [0, -2, 0.8]].forEach(function(o){ g.save(); g.translate(ex + o[0], ey + o[1]); g.scale(o[2], o[2]); critter(ART[n.id], 0, 0, t + o[0] * 40); g.restore(); }); }
        else { g.save(); g.translate(ex, ey); g.scale(isB ? 1 : 0.9, isB ? 1 : 0.9); critter(ART[n.id], 0, 0, t); g.restore(); }
        var bob = Math.round(Math.sin(t / 150)); R("#C0392B", ex - 3, ey - 34 + bob, 7, 7); R("#fff", ex, ey - 33 + bob, 1, 3); R("#fff", ex, ey - 29 + bob, 1, 1);
        if(isB){ R("#F7C948", ex - 5, ey - 42, 11, 2); R("#F7C948", ex - 5, ey - 45, 2, 3); R("#F7C948", ex, ey - 46, 2, 4); R("#F7C948", ex + 4, ey - 45, 2, 3); } } }); }
  });
  var tired = !canAdvance() && !J.pending(S) && J.nodeAt(S.node).type !== "end" && np.p >= S.node - 0.05;
  if(tired){ var cp = along(S.node); objs.push({ z: cp.x + cp.y + 0.2, f: function(){ campfire(Math.round(isoX(cp.x + 0.8, cp.y + 0.2)), Math.round(isoY(cp.x + 0.8, cp.y + 0.2) + 3), t); } }); }
  objs.push({ z: pos.x + pos.y + 0.1, f: function(){ var sx = Math.round(isoX(pos.x, pos.y)), sy = Math.round(isoY(pos.x, pos.y)); R("rgba(20,38,27,.3)", sx - 10, sy + 1, 20, 2); party(sx, sy, walkT > 0 ? t : 0); } });
  objs.sort(function(a, b){ return a.z - b.z; }); objs.forEach(function(o){ o.f(); });
  c.setTransform(dpr, 0, 0, dpr, 0, 0);
  // joystick + banner (css px)
  var bx = 62, by = cssH - 62; c.globalAlpha = joy ? 0.9 : 0.45; if(joy){ bx = joy.x0; by = joy.y0; }
  c.fillStyle = "rgba(20,38,27,.35)"; c.beginPath(); c.arc(bx, by, 34, 0, 7); c.fill(); c.strokeStyle = "#FBF7EA"; c.lineWidth = 2; c.stroke();
  c.fillStyle = "#FBF7EA"; c.beginPath(); c.arc(joy ? joy.x0 + joy.dx * 28 : bx, joy ? joy.y0 + joy.dy * 28 : by, 13, 0, 7); c.fill(); c.globalAlpha = 1;
  var age = (t - banner.t) / 1000; if(age >= 0 && age < 3.2){ c.globalAlpha = Math.min(1, 3.2 - age, age * 4); c.fillStyle = "rgba(20,38,27,.82)"; c.fillRect(0, 22, cssW, 44); c.fillStyle = "#F7C948"; c.font = "22px VT323, monospace"; c.textAlign = "center"; c.fillText(banner.text, cssW / 2, 51); c.textAlign = "left"; c.globalAlpha = 1; }
  if(!joy && !hintOnce.joy && S.node === 0 && S.cleared[1] !== true){ c.fillStyle = "rgba(20,38,27,.8)"; c.font = "18px VT323, monospace"; c.textAlign = "center"; c.fillText("Drag to walk (or use arrow keys / WASD)", cssW / 2, cssH - 14); c.textAlign = "left"; }
}
function campfire(x, y, t){ R("#5A3A22", x - 4, y - 1, 8, 2); var f = Math.floor(t / 130) % 2; R("#E4572E", x - 2, y - 5 - f, 4, 4 + f); R("#F7C948", x - 1, y - 4, 2, 3); }
function update(dt, t){
  if(settings.tab !== "road" || document.querySelector("dialog[open]") || $("overlay").classList.contains("show") || $("fightov").classList.contains("show")){ walkT = 0; syncAct(); return; }
  var dx = 0, dy = 0, str = 0;
  if(joy){ dx = joy.dx; dy = joy.dy; str = joy.m; }
  else { if(keys.ArrowLeft || keys.a) dx -= 1; if(keys.ArrowRight || keys.d) dx += 1; if(keys.ArrowUp || keys.w) dy -= 1; if(keys.ArrowDown || keys.s) dy += 1; var l = Math.sqrt(dx * dx + dy * dy); if(l){ dx /= l; dy /= l; str = 1; } }
  walkT = str > 0.05 ? walkT + dt : 0;
  if(str > 0.05){
    var sp = SPEED * str * dt, gvx = (dx / (TW / 2) + dy / (TH / 2)) / 2 * sp, gvy = (dy / (TH / 2) - dx / (TW / 2)) / 2 * sp, lim = limitP();
    function ok(x, y){ var n = near(x, y); return n.d <= WALK && n.p <= lim + 0.0001; }
    if(ok(pos.x + gvx, pos.y + gvy)){ pos.x += gvx; pos.y += gvy; } else if(ok(pos.x + gvx, pos.y)) pos.x += gvx; else if(ok(pos.x, pos.y + gvy)) pos.y += gvy;
    hintOnce.joy = true;
  }
  var p = curP();
  if(canAdvance() && p >= S.node + 1 - 0.05) arrive();
  else if(!canAdvance() && !J.pending(S) && p >= S.node - 0.05 && J.nodeAt(S.node).type !== "end" && !hintOnce["t" + S.node + S.day + S.march]){ hintOnce["t" + S.node + S.day + S.march] = true; toast(S.rest ? "The army is resting at the hospital." : S.hp <= 0 ? "The army has no health left." : "The army is too tired. Solve a puzzle or start a new day for energy."); }
  syncAct();
}
function syncAct(){
  var pn = J.pending(S), want = "", p = curP();
  if(pn && p >= S.node - 0.14 && !run){ want = pn.boss ? "boss" : "fight"; }
  if(want === lastAct && want !== "fight") return; var b = $("rdAct");
  if(!want){ b.hidden = true; lastAct = ""; return; }
  var label = want === "boss" ? "Face the " + J.BOSSES[pn.boss].name : (function(){ var o = J.odds(S, pn); return "Charge! · " + o.verdict + " · about -" + o.damage + " health"; })();
  if(b.textContent !== label) b.textContent = label; b.hidden = false; b.setAttribute("data-act", want); if(lastAct !== want){ lastAct = want; sfx("bossin"); renderHere(); }
}
function arrive(){
  var r = J.march(S); if(!r.ok) return; persist(); var n = r.node; sfx("pindrop"); renderHud();
  if(n.give){ sfx("collect"); toast("Found " + n.name + ": " + lootText(n.give)); }
  else if(n.type === "town"){ sfx("correct"); toast("Checkpoint: " + n.name); }
  else if(n.enemy){ sfx("whoosh"); toast("A " + n.name.toLowerCase() + " blocks the road!"); }
  else if(n.boss){ sfx("bossin"); toast("Big boss ahead: " + n.name); }
  else if(n.type === "end") { sfx("milestone"); toast("Region 1 complete!"); }
  renderHere(); renderHud();
}
function renderHere(){
  var n = J.nodeAt(S.node), p = J.pending(S), html = "", max = J.maxHp(S), reg = REGION[n.country];
  $("prog").textContent = "stage " + STAGE[S.node] + " · node " + S.node + " / " + (J.ROAD.length - 1);
  html += '<div class="ctry">' + reg.n + ' · ' + reg.lv + ' · stage ' + STAGE[S.node] + '</div><h2>' + esc(n.name) + '</h2>';
  if(p && p.enemy){
    var o = J.odds(S, p);
    html += '<p class="note">' + (p.type === "army" ? "An enemy army blocks the road." : p.type === "mini" ? "A mini-boss guards the way." : "A creature blocks the road.") + ' No puzzle here: the army fights on its own.</p>' +
      '<div class="odds"><span>Your attack <b>' + o.attack + '</b></span><span>vs <b>' + o.enemy + '</b></span><span class="verdict ' + o.verdict.replace(" ", "") + '">' + o.verdict + '</span><span>about <b>-' + o.damage + '</b> health</span></div>' +
      '<p class="note">Loot: ' + lootText(p.loot) + '. ' + (o.win ? "" : "A loss sends the army back to the last town. ") + 'Weak to: ' + J.HEROES[p.enemy.weak].name + ' (+4 attack per level). Not ready? Walk back and train, forge or rest first.</p>';
  } else if(p && p.boss){
    var b = J.BOSSES[p.boss], tried = !J.bossCanTry(S);
    html += '<p class="note"><b>Big boss · ' + b.tier + '.</b> ' + b.fact + '</p><p class="note">Challenge: <b>' + J.PUZZLES[b.puzzle].name + '</b> (' + b.difficulty + '). Win: ' + lootText(b.reward) + ' and the <b>' + b.trophy + '</b> trophy (+5 max health).</p>' + (tried ? '<p class="note"><b>The boss already won today.</b> Come back tomorrow.</p>' : "");
  } else {
    html += '<p class="note">' + (n.text || (n.give ? "Collected: " + lootText(n.give) + "." : "Cleared.")) + '</p>';
    if(n.type === "end") html += '<p class="note"><b>Region 1 complete.</b> Region 2 is on its way.</p>';
    else html += '<p class="note">Walk to the next stage. Each new stage on the road costs <b>1 energy</b> (you have ' + S.march + '). Puzzles and new days refill it. Walking back is free.</p>';
  }
  if(S.hp < max * 0.5 && !S.rest) html += '<p class="note" style="color:#9C4A25"><b>The army is hurt.</b> ' + (S.buildings.hospital ? "Rest it in the Army tab before the next fight." : "Build a Hospital in the City to heal it.") + '</p>';
  $("here").innerHTML = html;
}
$("rdAct").addEventListener("click", function(){ var a = this.getAttribute("data-act"); if(a === "fight") doFight(); else if(a === "boss") openBoss(); });
(function(){
  var cv = $("roadCv");
  cv.addEventListener("pointerdown", function(e){ var r = cv.getBoundingClientRect(); joy = { id: e.pointerId, x0: e.clientX - r.left, y0: e.clientY - r.top, dx: 0, dy: 0, m: 0 }; try{ cv.setPointerCapture(e.pointerId); }catch(x){} e.preventDefault(); });
  cv.addEventListener("pointermove", function(e){ if(!joy || e.pointerId !== joy.id) return; var r = cv.getBoundingClientRect(), vx = e.clientX - r.left - joy.x0, vy = e.clientY - r.top - joy.y0, m = Math.sqrt(vx * vx + vy * vy); if(m > 6){ joy.dx = vx / m; joy.dy = vy / m; joy.m = Math.min(1, m / 40); } else { joy.dx = joy.dy = 0; joy.m = 0; } if(m > 46){ joy.x0 += vx / m * (m - 46); joy.y0 += vy / m * (m - 46); } });
  function end(e){ if(joy && e.pointerId === joy.id) joy = null; } cv.addEventListener("pointerup", end); cv.addEventListener("pointercancel", end);
  window.addEventListener("keydown", function(e){ var k = e.key.length === 1 ? e.key.toLowerCase() : e.key; if(["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "w", "a", "s", "d"].indexOf(k) >= 0){ keys[k] = true; if(settings.tab === "road" && k.indexOf("Arrow") === 0) e.preventDefault(); } });
  window.addEventListener("keyup", function(e){ var k = e.key.length === 1 ? e.key.toLowerCase() : e.key; keys[k] = false; });
  window.addEventListener("blur", function(){ keys = {}; });
})();
function doFight(){
  var n = J.pending(S), before = S.node; if(!n) return; var o = J.odds(S, n), res = J.fight(S); persist(); renderHud(); $("rdAct").hidden = true; lastAct = "";
  playFight(n, res, function(){ if(!res.won && res.retreatTo !== undefined){ toast("Retreated to " + J.nodeAt(S.node).name); placeAt(S.node); } renderAll(); }, o);
}
/* stage map */
var mapPts = null;
function drawMap(){
  var cv = $("mapCv"), cssW = Math.min(420, window.innerWidth * 0.88), cssH = Math.min(560, window.innerHeight * 0.72), dpr = Math.min(3, window.devicePixelRatio || 1);
  cv.style.width = cssW + "px"; cv.style.height = cssH + "px"; cv.width = cssW * dpr; cv.height = cssH * dpr; var c = cv.getContext("2d"); c.setTransform(dpr, 0, 0, dpr, 0, 0); c.imageSmoothingEnabled = false;
  var pad = 36; mapPts = J.ROAD.map(function(n, k){ var row = Math.floor(k / 6), col = k % 6; if(row % 2) col = 5 - col; return { x: pad + col * ((cssW - pad * 2) / 5), y: pad + 18 + row * ((cssH - pad * 2 - 30) / 3.5) + Math.sin(k * 1.3) * 10 }; });
  c.fillStyle = "#D9B77A"; c.fillRect(0, 0, cssW, cssH); c.fillStyle = "rgba(255,255,255,.12)"; for(var i = 0; i < 60; i++) c.fillRect((i * 97) % cssW, (i * 53) % cssH, 14, 4);
  var cols = { jungle: "rgba(63,165,95,.45)", swamp: "rgba(58,150,140,.45)", volcano: "rgba(228,87,46,.4)" };
  mapPts.forEach(function(p, idx){ c.fillStyle = cols[REGION[J.ROAD[idx].country].b]; c.beginPath(); c.arc(p.x, p.y, 34, 0, 7); c.fill(); });
  c.strokeStyle = "#8D6E3C"; c.lineWidth = 9; c.lineCap = "round"; c.lineJoin = "round"; c.beginPath(); mapPts.forEach(function(p, i){ i ? c.lineTo(p.x, p.y) : c.moveTo(p.x, p.y); }); c.stroke();
  c.strokeStyle = "#F2D79B"; c.lineWidth = 5; c.stroke();
  var done = {}; c.font = "17px VT323, monospace"; c.textAlign = "center";
  J.ROAD.forEach(function(n, idx){ var p = mapPts[idx], cl = S.cleared[n.id], reach = idx <= S.node, col = n.boss ? "#8E3FA8" : n.enemy ? "#C0392B" : n.type === "town" ? "#3A7BD5" : n.type === "end" ? "#2E9B57" : n.give ? "#F7C948" : "#2E9B57";
    c.fillStyle = "#14261B"; c.beginPath(); c.arc(p.x, p.y, n.boss ? 13 : 10, 0, 7); c.fill(); c.fillStyle = (n.enemy || n.boss) && cl ? "#3A7BD5" : col; c.beginPath(); c.arc(p.x, p.y, n.boss ? 11 : 8, 0, 7); c.fill();
    c.fillStyle = "#fff"; c.fillText(n.boss ? "B" : n.enemy ? ((cl) ? "✓" : "!") : n.type === "town" ? "T" : n.give ? "?" : n.type === "end" ? "⚑" : "⌂", p.x, p.y + 4);
    c.fillStyle = "#14261B"; c.fillText(STAGE[idx], p.x, p.y - 15); if(!reach){ c.fillStyle = "rgba(20,38,27,.35)"; c.beginPath(); c.arc(p.x, p.y, 10, 0, 7); c.fill(); }
    var rg = REGION[n.country]; if(!done[n.country]){ done[n.country] = 1; c.fillStyle = "#4A2F12"; c.font = "19px VT323, monospace"; c.fillText(rg.n + " · " + rg.lv, Math.max(115, Math.min(cssW - 115, p.x)), p.y + 33); c.font = "17px VT323, monospace"; } });
  var me = mapPts[Math.min(S.node, mapPts.length - 1)]; c.fillStyle = "#14261B"; c.beginPath(); c.arc(me.x, me.y - 28 + Math.round(Math.sin(performance.now() / 200) * 2), 6, 0, 7); c.fill(); c.fillStyle = "#F7C948"; c.beginPath(); c.arc(me.x, me.y - 28 + Math.round(Math.sin(performance.now() / 200) * 2), 4, 0, 7); c.fill();
}
$("rd-map").onclick = function(){ $("dlg-map").showModal(); drawMap(); sfx("pageflip"); };
$("map-close").onclick = function(){ $("dlg-map").close(); };
$("mapCv").addEventListener("click", function(e){ if(!mapPts) return; var r = this.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top, best = -1, bd = 24; mapPts.forEach(function(p, i){ var d = Math.hypot(p.x - x, p.y - y); if(d < bd){ bd = d; best = i; } });
  if(best >= 0){ if(best <= S.node){ $("dlg-map").close(); placeAt(best); sfx("whoosh"); toast("Travelled to " + J.nodeAt(best).name); } else { toast("Not reached yet. Walk there first."); sfx("notquite"); } } });

/* ================= skirmish ================= */
function playFight(n, res, done, odds){
  var ov = $("fightov"), cv = $("fightCv"), c = cv.getContext("2d"), t0 = performance.now(), ended = false, boss = !!n.boss;
  $("f-title").textContent = n.name; $("f-res").innerHTML = '<p class="note">The army moves in…</p>'; $("f-ok").style.display = "none"; ov.classList.add("show"); sfx("whoosh");
  c.imageSmoothingEnabled = false; var hit1 = false, hit2 = false;
  function frame(now){
    var t = (now - t0) / 1000; g = c; c.setTransform(1, 0, 0, 1, 0, 0); c.clearRect(0, 0, 150, 60);
    for(var y = 0; y < 36; y += 4) R(y < 14 ? "#5BA8F5" : "#8EC5FC", 0, y, 150, 4); R("#6CC36C", 0, 36, 150, 24); R("#3F9A4B", 0, 36, 150, 1);
    var lunge = t > 0.4 && t < 1.0 ? Math.sin((t - 0.4) / 0.6 * Math.PI) * 34 : 0, clash = t > 0.62 && t < 0.9, shake = clash ? (Math.round(t * 40) % 2 ? 2 : -2) : 0;
    if(t > 0.6 && !hit1){ hit1 = true; sfx("hit"); } if(t > 0.8 && !hit2){ hit2 = true; sfx(res.won ? "hit" : "miss"); }
    c.save(); c.translate(28 + lunge, 54); party(0, 0, now); c.restore();
    var gone = res.won && t > 1.0; if(!gone || Math.floor(t * 12) % 2 === 0){ c.save(); c.translate(116 + shake, 54); c.scale(-1, 1); var sw = !boss && n.type !== "mini"; if(sw){ [[-14, 2], [8, -2], [26, 3]].forEach(function(o){ c.save(); c.translate(o[0], o[1]); c.scale(1.1, 1.1); critter(ART[n.id], 0, 0, now + o[0] * 30); c.restore(); }); } else { c.save(); c.scale(boss ? 1.4 : 1.5, boss ? 1.4 : 1.5); critter(ART[n.id], 0, 0, now); c.restore(); } c.restore(); }
    if(odds){ [0.27, 0.18, 0.33, 0.22].forEach(function(f, i){ var s0 = 0.66 + i * 0.13; if(t > s0 && t < s0 + 0.5){ g.fillStyle = "#F7C948"; g.font = "9px VT323, monospace"; g.fillText("-" + Math.round(odds.attack * f), 96 + (i % 2) * 14 - (i > 1 ? 10 : 0), 28 - (t - s0) * 24 - (i % 2) * 5); } }); }
    if(clash){ R("#fff", 62 + (Math.round(t * 30) % 4), 30, 3, 3); R("#F7C948", 70, 26 + (Math.round(t * 20) % 3), 3, 3); }
    if(t > 1.0){ g.fillStyle = "#14261B"; g.font = "9px VT323, monospace"; g.fillText("-" + res.damage, 28, 24 - Math.min(10, (t - 1.0) * 14)); }
    if(t > 1.5 && !ended){ ended = true; finishFight(); }
    if(!ended || t < 1.6) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  function finishFight(){
    hurt(); var html;
    if(res.won){ sfx("correct"); html = '<h3>Victory!</h3><p class="note">The army took <b>-' + res.damage + '</b> health. Loot: ' + lootText(res.loot) + '.</p>'; }
    else { sfx("notquite"); html = '<h3>Defeat…</h3><p class="note">The enemy was too strong: <b>-' + res.damage + '</b> health. The army retreats to ' + esc(J.nodeAt(res.retreatTo).name) + ' and keeps 10% health. Nothing is lost: rest and try again.</p>'; }
    $("f-res").innerHTML = html; $("f-ok").style.display = ""; $("f-ok").onclick = function(){ ov.classList.remove("show"); sfx("tap"); done(); };
  }
}

/* ================= puzzles (embedded games) ================= */
var run = null;
function openBoss(){
  var cfg = J.bossConfig(S), b = J.BOSSES[cfg.boss], P = J.PUZZLES[cfg.puzzle];
  if(!cfg.unlocked){ var bid = J.puzzleBuilding(cfg.puzzle); popup({ title: b.name + " guards the road", html: "<p>This boss fights with <b>" + P.name + "</b>. Unlock it first: upgrade the <b>" + J.BUILDINGS[bid].name + "</b> to level " + J.PUZZLE_UNLOCK_LEVEL + " in the City.</p>", buttons: [{ label: "To the City", primary: true, fn: function(){ tab("city"); } }, { label: "Close" }] }); return; }
  sfx("bossin");
  popup({ title: "Boss: " + b.name, html: '<p class="note">' + b.home + ' · ' + b.tier + '</p><p>' + b.fact + '</p><ul><li>Puzzle: <b>' + P.name + '</b> (' + cfg.difficulty + ')</li>' + (cfg.seconds ? '<li>Time: <b>' + fmtTime(cfg.seconds) + '</b> (' + cfg.heroSeconds + ' s from heroes, ' + cfg.moraleSeconds + ' s from army health)</li>' : '<li>Time: the maze clock plus <b>' + cfg.zameBonusSeconds + ' s</b> from heroes and army health</li>') + '<li>Hints: <b>' + (J.PUZZLES[cfg.puzzle] ? (S.heroes ? J.heroBonus(S, cfg.puzzle).hints : 0) : 0) + ' extra</b> from your heroes</li><li>Win: ' + lootText(b.reward) + ' + the ' + b.trophy + ' trophy</li><li>Lose: the army loses about ' + Math.round(b.loseDamage * 100) + '% health, and the boss waits until tomorrow</li></ul>',
    buttons: [{ label: "Not yet" }, { label: "Fight!", primary: true, fn: function(){ openPuzzle({ puzzle: cfg.puzzle, difficulty: cfg.difficulty, boss: cfg }); } }] });
}
function openPuzzle(o){
  var P = J.PUZZLES[o.puzzle], html;
  try{ html = JSON.parse($("puz-" + o.puzzle).textContent); }catch(e){ toast("Puzzle file missing"); return; }
  var hb = J.heroBonus(S, o.puzzle); run = { puzzle: o.puzzle, difficulty: o.difficulty, boss: o.boss || null, done: false, left: o.boss ? o.boss.seconds : 0, timer: null };
  $("ov-title").textContent = (o.boss ? "Boss: " + J.BOSSES[o.boss.boss].name + " · " : "") + P.name; $("ov-clock").textContent = ""; $("ov-res").classList.remove("show");
  var old = $("ov-body").querySelector("iframe"); if(old) old.remove();
  var f = document.createElement("iframe"); f.setAttribute("title", P.name); f.srcdoc = html;
  f.onload = function(){
    try{
      var w = f.contentWindow, gm = w[GAME[o.puzzle]]; if(!gm || !gm.start) throw new Error("no hooks");
      if(gm.config){ gm.config.bonusHints = o.boss ? o.boss.bonusHints : hb.hints; gm.config.bonusSeconds = o.boss ? o.boss.zameBonusSeconds : hb.seconds; }
      gm.onFinish = function(info){ finishRun(!!(info && info.won), info && info.difficulty); };
      gm.start({ difficulty: o.difficulty, index: o.boss ? o.boss.index : undefined, locked: true });
    }catch(e){ toast("Could not start the puzzle"); }
  };
  $("ov-body").insertBefore(f, $("ov-res")); $("overlay").classList.add("show"); sfx("whoosh");
  if(o.boss && o.boss.seconds){ $("ov-clock").textContent = fmtTime(run.left); run.timer = setInterval(function(){ if(document.visibilityState !== "visible" || run.done) return; run.left--; $("ov-clock").textContent = fmtTime(run.left); $("ov-clock").classList.toggle("low", run.left <= 15); if(run.left <= 0){ sfx("notquite"); finishRun(false, null, true); } }, 1000); }
}
function closeOverlay(){
  if(run && run.timer) clearInterval(run.timer); run = null; $("overlay").classList.remove("show"); $("ov-res").classList.remove("show");
  var f = $("ov-body").querySelector("iframe"); if(f) f.remove(); renderAll();
}
function finishRun(won, diff, timeout){
  if(!run || run.done) return; run.done = true; if(run.timer) clearInterval(run.timer); var r = run, html, d = r.difficulty;
  setTimeout(function(){
    if(r.boss){
      var br = J.bossFinish(S, won); persist();
      if(won){ sfx("bossend"); html = '<h2>' + esc(J.BOSSES[r.boss.boss].name) + ' defeated!</h2><p>Loot: <b>' + lootText(br.reward) + '</b></p><p>Trophy: <b>' + esc(br.trophy) + '</b> (+5 max health)</p>'; setTimeout(function(){ sfx("solved"); }, 700); }
      else { sfx("notquite"); html = '<h2>' + (timeout ? "Out of time" : "The boss wins today") + '</h2><p>The army took <b>-' + br.damage + '</b> health. Nothing is lost: ' + esc(J.BOSSES[r.boss.boss].name) + ' will wait for you tomorrow.</p>'; }
    } else {
      var pr = J.puzzleDone(S, r.puzzle, d, won); persist();
      if(won && pr.paid){ sfx("solved"); html = '<h2>Solved!</h2><p>The city earned <b>' + lootText(pr.reward) + '</b> and <b>+1 march point</b>.</p>'; }
      else if(won){ sfx("correct"); html = '<h2>Solved again!</h2><p>Today\'s reward for ' + J.PUZZLES[r.puzzle].name + ' was already paid. Great practice.</p>'; }
      else { sfx("notquite"); html = '<h2>Not this time</h2><p>No harm done. Try again whenever you like.</p>'; }
    }
    $("ov-card").innerHTML = html + '<div class="acts" style="display:flex;justify-content:flex-end;margin-top:10px"><button class="btn primary" id="ov-ok">' + (r.boss ? "Back to the road" : "Back to the city") + '</button></div>';
    $("ov-ok").onclick = function(){ closeOverlay(); if(r.boss) tab("road"); };
    $("ov-res").classList.add("show"); renderHud();
  }, 1300);
}
$("ov-close").onclick = function(){
  if(run && !run.done && run.boss){ popup({ title: "Leave the fight?", html: "<p>If you leave now, the boss wins today and the army takes damage.</p>", buttons: [{ label: "Stay" }, { label: "Leave", danger: true, fn: function(){ finishRun(false); } }] }); return; }
  closeOverlay();
};

/* ================= wiring ================= */
function tab(v){
  settings.tab = v; store(KEY_SET, settings);
  ["city", "road", "army"].forEach(function(k){ $("v-" + k).classList.toggle("show", k === v); $("t-" + k).setAttribute("aria-pressed", String(k === v)); });
  renderAll(); sfx("tap");
}
["city", "road", "army"].forEach(function(k){ $("t-" + k).onclick = function(){ tab(k); }; });
function renderAll(){ renderHud(); renderCards(); renderHere(); if(settings.tab === "army") renderArmy(); }
$("btn-help").onclick = function(){ $("dlg-help").showModal(); };
$("btn-tools").onclick = function(){ $("dlg-tools").showModal(); };
$("btn-sound").onclick = function(){ settings.sfx = !settings.sfx; store(KEY_SET, settings); applySound(); if(settings.sfx) Sound.play("collect"); };
$("tool-day").onclick = function(){ var r = J.nextDay(S); persist(); $("dlg-tools").close(); toast("Day " + S.day + ": +" + r.march + " march" + (Object.keys(r.produced).length ? ", " + lootText(r.produced) : "")); sfx("milestone"); renderAll(); };
$("tool-res").onclick = function(){ J.RES.forEach(function(r){ S.res[r] += 100; }); persist(); renderAll(); sfx("collect"); };
$("tool-hp").onclick = function(){ S.hp = Math.max(1, Math.round(J.maxHp(S) * 0.2)); persist(); hurt(); renderAll(); };
$("tool-reset").onclick = function(){ S = J.normaliseState(null); persist(); placeAt(0); prevRes = null; $("dlg-tools").close(); renderAll(); };
setInterval(function(){
  if(J.tickRest(S, Date.now())){ persist(); toast("The army is rested and ready!"); sfx("correct"); renderAll(); } else if(S.rest){ renderHud(); if(settings.tab === "army") renderArmy(); }
}, 500);
function loop(t){ if(settings.tab === "city") drawCity(t); else if(settings.tab === "road") roadFrame(t); requestAnimationFrame(loop); }
window.addEventListener("resize", function(){ renderAll(); });
document.addEventListener("pointerdown", function once(){ document.removeEventListener("pointerdown", once); try{ Sound.play("tap"); }catch(e){} }, { once: true });
applySound(); tab(settings.tab || "city"); requestAnimationFrame(loop);
})();
</script>
</body>
</html>
