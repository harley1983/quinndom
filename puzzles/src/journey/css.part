main{display:block;max-width:1080px;padding:10px 14px 28px}
.hud{position:sticky;top:0;z-index:15;background:var(--mist);border-bottom:2px solid var(--sand);padding:8px 14px 8px}
.hudin{max-width:1080px;margin:0 auto;display:flex;flex-direction:column;gap:6px}
.res{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.rc{display:flex;flex-direction:column;align-items:center;background:#fff;border:2px solid var(--ink);border-radius:8px;padding:2px 0 1px;box-shadow:0 2px 0 var(--ink)}
.rc i{font-style:normal;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--moss);line-height:1.1}
.rc b{font:400 22px/1 var(--font-pixel)}
.rc.wood b{color:#8D6E63}.rc.stone b{color:#6F7C76}.rc.metal b{color:#4A6074}.rc.food b{color:#B02A22}.rc.mimosa b{color:#D81B8A}.rc.psilocybe b{color:#7B5EA7}
.rc.flash{animation:flash .6s}
@keyframes flash{30%{background:var(--note,#FFF3C4);transform:translateY(-2px)}}
.row2{display:flex;gap:8px;align-items:center}
.hp{flex:1;min-width:0;position:relative;height:26px;background:#fff;border:2px solid var(--ink);border-radius:8px;overflow:hidden;box-shadow:0 2px 0 var(--ink)}
.hp i{position:absolute;inset:0 auto 0 0;background:#2E9B57;transition:width .5s,background .3s}
.hp.mid i{background:#E9B93A}.hp.low i{background:#C0392B}
.hp span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:20px/1 var(--font-pixel);color:var(--ink);text-shadow:0 0 3px #fff,0 0 3px #fff}
.hp.hurt{animation:shake .4s}
.pill{display:flex;align-items:baseline;gap:4px;background:#fff;border:2px solid var(--ink);border-radius:8px;padding:2px 8px;box-shadow:0 2px 0 var(--ink);font:22px/1 var(--font-pixel)}
.pill small{font:700 10px var(--font-body);text-transform:uppercase;letter-spacing:.5px;color:var(--moss)}
.tabs{display:flex;margin:10px 0}
.tabs .seg{width:100%}.tabs .seg button{flex:1;padding:10px 6px;font-size:16px}
.view{display:none}.view.show{display:block}
.card{background:#fff;border:2px solid var(--ink);border-radius:14px;padding:12px 14px;box-shadow:0 4px 0 var(--ink)}
.card h2,.card h3{margin:0;font-family:var(--font-head)}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px;margin-top:12px}
.bcard{display:flex;flex-direction:column;gap:6px;transition:box-shadow .3s}
.bcard.hi{animation:flash .9s}
.bcard .top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.bcard h3{font-size:17px}.grp{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--moss)}
.pips{display:flex;gap:4px}.pips i{width:14px;height:14px;border:2px solid var(--ink);background:#fff}.pips i.on{background:var(--sun)}
.note{font-size:14px;color:#4a5e50}
.cost{display:flex;gap:6px;flex-wrap:wrap}.cost span{font:20px/1 var(--font-pixel);padding:2px 7px;border:2px solid var(--ink);border-radius:6px;background:var(--mist)}
.cost span.short{background:#FBE3DF;color:#9C2A1D}
.puz{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 10px;border-radius:10px;background:var(--note,#FFF3C4);border:2px dashed var(--brass);font-size:14px}
.puz.locked{background:#EEF0EA;border-color:#B8C0B8;color:#6b7a70}
.puz.open{background:#E3F4DE;border-style:solid;border-color:var(--canopy)}
.btn{white-space:nowrap;border:2px solid var(--ink);background:#fff;border-radius:10px;padding:9px 14px;font-family:var(--font-head);font-weight:700;font-size:15px;cursor:pointer;box-shadow:0 3px 0 var(--ink)}
.btn:active{transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
.btn.primary{background:var(--canopy);color:#fff}.btn.small{padding:6px 12px;font-size:14px}.btn.big{height:52px;padding:0 26px;font-size:18px}
.btn.danger{background:#C0392B;color:#fff}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:0 3px 0 var(--ink)}
.linkbtn{border:0;background:none;padding:2px 0;font:inherit;font-weight:700;color:var(--ink);text-decoration:underline;cursor:pointer}
.scene{border:3px solid var(--ink);border-radius:6px;box-shadow:0 5px 0 rgba(20,38,27,.9);overflow:hidden;line-height:0;background:#8EC5FC}
.scene canvas{display:block;width:100%;image-rendering:pixelated;cursor:pointer}
.roadwrap{position:relative}
.roadwrap canvas{height:380px;cursor:default;touch-action:none;background:#27422D}.mapbtn{position:absolute;top:8px;right:8px;line-height:1.2}.rdact{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);line-height:1.2;max-width:92%;z-index:2}#dlg-map{max-width:min(440px,94vw);padding:10px}.mapbar{display:flex;align-items:center;gap:8px;margin-bottom:8px}.mapbar .note{flex:1;font-size:12px}#mapCv{display:block;border:2px solid var(--ink);border-radius:8px;image-rendering:pixelated;margin:0 auto}
.region{display:flex;justify-content:space-between;align-items:center;margin:0 2px 8px;font-family:var(--font-head);font-weight:700}
.region small{font:20px var(--font-pixel);color:var(--forest)}
.here{margin-top:12px;display:flex;flex-direction:column;gap:8px}
.here h2{font-size:20px}.here .ctry{font:20px var(--font-pixel);color:var(--moss)}
.odds{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:15px}
.odds b{font:26px/1 var(--font-pixel)}
.verdict{padding:2px 10px;border-radius:999px;border:2px solid var(--ink);font-weight:700;font-size:13px;text-transform:uppercase}
.verdict.easy{background:#CDEBC8}.verdict.risky{background:#F6DE92}.verdict.toostrong{background:#F2B2A8}
.marchbar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.statgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-top:8px}
.stat{background:var(--mist);border:2px solid var(--sand);border-radius:10px;padding:6px 10px}
.stat i{font-style:normal;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--moss);display:block}.stat b{font:26px/1 var(--font-pixel);color:var(--forest)}
.sect{margin-top:14px}.sect>h3{margin:0 0 8px;font-size:18px;font-family:var(--font-head)}
.herocards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.hero .lv{font:28px/1 var(--font-pixel);color:var(--forest)}
.restbar{height:16px;border:2px solid var(--ink);border-radius:8px;background:#fff;overflow:hidden}.restbar i{display:block;height:100%;background:#7DEBB0;transition:width .3s}
.trophies{display:flex;gap:8px;flex-wrap:wrap}.trophies span{padding:4px 10px;border:2px solid var(--brass);border-radius:999px;background:var(--note,#FFF3C4);font-weight:700;font-size:14px}
.toast-host{position:fixed;top:150px;left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none;z-index:80}
.toast{background:var(--ink);color:var(--mist);padding:10px 16px;border-radius:10px;font-family:var(--font-head);font-weight:700;font-size:15px;box-shadow:0 4px 0 rgba(0,0,0,.25);animation:rowin .25s ease-out}
@keyframes rowin{from{opacity:0;transform:translateY(-6px)}}
@keyframes shake{10%,90%{transform:translateX(-2px)}20%,80%{transform:translateX(4px)}30%,50%,70%{transform:translateX(-6px)}40%,60%{transform:translateX(6px)}}
dialog{border:2px solid var(--ink);border-radius:16px;padding:0;max-width:min(460px,92vw);width:100%;background:var(--mist);color:var(--ink);box-shadow:0 6px 0 var(--ink)}
dialog::backdrop{background:rgba(29,53,87,.6)}
.dlg{padding:18px 18px 16px}.dlg h2{margin:0 0 8px;font-family:var(--font-head);font-size:22px}.dlg p{margin:0 0 10px;line-height:1.45}
.dlg .acts{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-top:12px}
.dlg .diffs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.dlg .diffs .btn{padding:10px 4px;line-height:1.15}.dlg .diffs small{display:block;font-weight:500;font-size:12px}
.dlg .diffs .btn.sug{outline:3px solid var(--sun)}
.dlg ul{margin:0 0 10px;padding-left:20px}.dlg li{margin:2px 0}
.big-sprite{display:block;margin:0 auto 8px;image-rendering:pixelated}
.overlay{position:fixed;inset:0;z-index:60;background:#0D1812;display:none;flex-direction:column}
.overlay.show{display:flex}
.ovbar{display:flex;align-items:center;gap:10px;padding:8px 12px;background:#14251D;color:var(--mist);border-bottom:3px solid var(--brass)}
.ovbar h2{margin:0;font-family:var(--font-head);font-size:18px;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ovbar .clock{font:30px/1 var(--font-pixel);color:#00F5FF;letter-spacing:1px}.ovbar .clock.low{color:#FF6B6B}
.overlay iframe{flex:1;width:100%;border:0;background:var(--mist)}
.ovres{position:absolute;inset:0;background:rgba(13,24,18,.82);display:none;align-items:center;justify-content:center;padding:16px}
.ovres.show{display:flex}.ovres .card{max-width:440px;width:100%}
.fightov{position:fixed;inset:0;z-index:70;background:rgba(13,24,18,.88);display:none;align-items:center;justify-content:center;padding:14px}
.fightov.show{display:flex}.fightov .card{max-width:460px;width:100%;display:flex;flex-direction:column;gap:10px}
.fightov canvas{width:100%;height:auto;image-rendering:pixelated;background:linear-gradient(#8EC5FC,#CFE9FF 60%,#6CC36C 60%);border:3px solid var(--ink);border-radius:6px}
.fres{min-height:64px}

@media (prefers-reduced-motion:reduce){.rc.flash,.bcard.hi,.hp.hurt,.toast{animation:none}}

.hudin{gap:6px}.hp{flex:none;width:100%;height:30px}
.worldwrap{position:relative;max-width:520px;margin:0 auto;border:3px solid var(--ink);border-radius:8px;box-shadow:0 5px 0 rgba(20,38,27,.9);overflow:hidden;background:#6CC36C}
.worldwrap canvas{display:block;width:100%;image-rendering:pixelated}
#worldNodes{position:absolute;inset:0}
.wnode{position:absolute;transform:translate(-50%,-50%);width:58px;height:58px;border:3px solid var(--ink);border-radius:12px;background:#F7C948;box-shadow:0 4px 0 var(--ink);font:34px/1 var(--font-pixel);color:var(--ink);display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0}
.wnode:active{transform:translate(-50%,-47%);box-shadow:0 1px 0 var(--ink)}
.wnode.done{background:#7BC67A}.wnode.lock{background:#C9CEC8;color:#6b7a70;cursor:not-allowed;font-size:24px}
.wnode.cur{animation:pulse 1.2s infinite}
@keyframes pulse{50%{box-shadow:0 4px 0 var(--ink),0 0 0 6px rgba(247,201,72,.55)}}
.nlabel{position:absolute;transform:translateY(-50%);width:min(178px,42%);background:rgba(251,247,234,.95);border:2px solid var(--ink);border-radius:10px;padding:6px 9px;box-shadow:0 3px 0 var(--ink);pointer-events:none;line-height:1.2}
.nlabel b{display:block;font:700 15px var(--font-head)}.nlabel small{display:block;font-size:12px;color:#4a5e50;margin-top:1px}
.nlabel .tag{display:inline-block;margin-top:4px;padding:1px 7px;border-radius:999px;border:2px solid var(--ink);background:#FFF3C4;font:700 11px var(--font-body);text-transform:uppercase;letter-spacing:.4px}
.nlabel.lock{opacity:.7}
.lvtop{display:flex;align-items:center;gap:10px;margin:0 0 8px}.lvname{font:700 17px var(--font-head)}
.lvwrap{position:relative;touch-action:none;user-select:none;-webkit-user-select:none}
.lvwrap canvas{display:block;width:100%;image-rendering:pixelated;cursor:default;background:#8EC5FC}
.lvact{position:absolute;left:50%;top:12px;transform:translateX(-50%);line-height:1.2;max-width:90%;z-index:2}.lvact[hidden]{display:none}
.pad{position:absolute;left:0;right:0;bottom:10px;display:flex;justify-content:flex-start;padding:0 12px;pointer-events:none}
.pad .pb{pointer-events:auto;width:62px;height:62px;border:3px solid var(--ink);border-radius:50%;background:rgba(251,247,234,.82);font:700 20px var(--font-head);color:var(--ink);box-shadow:0 3px 0 var(--ink);touch-action:none;-webkit-tap-highlight-color:transparent;padding:0}
.pad .pb:active,.pad .pb.on{background:#F7C948}
.pad .jump{width:86px;border-radius:32px;font-size:17px;margin-left:auto}
#c-right{margin-left:10px}
.lvhelp{margin:10px 2px 0}
@media (hover:hover) and (pointer:fine){.pad{display:none}}
</style>
</head>
